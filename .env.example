# 容器化开发环境变量模板（dev-first）
#
# 默认不需要复制：docker-compose.yml 已内置同样的开发默认值。
# 需要改端口/密码/连接/构建源时：
#   cp .env.example .env
#
# 警告：以下全部是本机开发默认值，只适合单机开发。
# 任何共享/生产环境必须覆盖 SECRET_KEY、POSTGRES_PASSWORD、MINIO_ROOT_USER、
# MINIO_ROOT_PASSWORD、ML_API_INTERNAL_TOKEN。

# ---------------------------------------------------------------------------
# 端口与容器用户
# ---------------------------------------------------------------------------
APP_PORT=8080
WEB_PORT=8010
APP_UID=1000
APP_GID=1000

# ---------------------------------------------------------------------------
# Django / 前端 HMR
# ---------------------------------------------------------------------------
DJANGO_DB=postgresql
HOST=http://localhost:8080
DEBUG=1
LOG_LEVEL=INFO
SECRET_KEY=dev-only-secret-key-change-me
BASE_DATA_DIR=/label-studio/data
LOCAL_MODEL_ROOT=/models
COLLECT_ANALYTICS=0

# HMR：app 会把前端资源指向 web 服务（8010）；置 0 前需在宿主机构建 web/dist
FRONTEND_HMR=1
FRONTEND_HOSTNAME=http://localhost:8010
# web 容器的 webpack-dev-server 代理目标（容器内用服务名 app）
DJANGO_HOSTNAME=http://app:8080

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=labelstudio
POSTGRES_USER=labelstudio
POSTGRES_PASSWORD=labelstudio
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis / RQ（django-rq + 训练队列 broker 共用）
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
RQ_DEFAULT_TIMEOUT=180
RQ_LONG_JOB_TIMEOUT=86400

# ---------------------------------------------------------------------------
# MinIO 对象存储（bucket 由 app 启动时自动创建）
# ---------------------------------------------------------------------------
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_STORAGE_ENDPOINT=http://minio:9000
MINIO_STORAGE_BUCKET_NAME=labelstudio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# FastAPI 训练/推理编排（ml-api，8991；ml profile）
# ---------------------------------------------------------------------------
ML_API_PORT=8991
ML_API_URL=http://ml-api:8991
ML_API_INTERNAL_TOKEN=dev-only-ml-api-token-change-me

# ---------------------------------------------------------------------------
# Worker 并发（均为 RQ worker 进程数；不是线程数）
# ---------------------------------------------------------------------------
LS_WORKER_CONCURRENCY=16
ML_WORKER_CONCURRENCY=2
# 训练 CPU 回退时的线程上限（有 GPU 时影响较小）
ML_WORKER_OMP_THREADS=8

# ---------------------------------------------------------------------------
# 训练参数
# ---------------------------------------------------------------------------
TRAINING_ARTIFACTS_STORAGE_PREFIX=trained
TRAINING_YOLO_VAL_SPLIT=0.2

# ---------------------------------------------------------------------------
# 镜像构建源与版本（网络慢时按需切换）
# ---------------------------------------------------------------------------
POETRY_PYPI_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ML_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
YARN_REGISTRY=https://registry.npmmirror.com
# 默认使用南京大学 PyTorch CUDA 13.0 镜像；官方索引为 https://download.pytorch.org/whl/cu130
TORCH_INDEX_URL=https://mirrors.nju.edu.cn/pytorch/whl/cu130
TORCH_VERSION=2.11.0
TORCHVISION_VERSION=0.26.0
APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn

# ---------------------------------------------------------------------------
# 可选：Sentry
# ---------------------------------------------------------------------------
# SENTRY_DSN=
# FRONTEND_SENTRY_DSN=
